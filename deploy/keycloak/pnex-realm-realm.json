{
  "realm": "pnex-realm",
  "enabled": true,
  "registrationAllowed": true,
  "resetPasswordAllowed": true,
  "accessTokenLifespan": 3600,
  "clients": [
    {
      "clientId": "pnex",
      "name": "PNEX",
      "description": "Client public PNEX (web CSR Dioxus) — PKCE S256 obligatoire",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:5150/auth/callback",
        "http://localhost:5151/auth/callback",
        "http://127.0.0.1:5150/auth/callback",
        "http://127.0.0.1:5151/auth/callback"
      ],
      "webOrigins": [
        "http://localhost:5150",
        "http://localhost:5151",
        "http://127.0.0.1:5150",
        "http://127.0.0.1:5151"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    }
  ],
  "users": [
    {
      "username": "alice",
      "email": "alice@example.com",
      "firstName": "Alice",
      "lastName": "Martin",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "alice-pass",
          "temporary": false
        }
      ],
      "id": "00000000-0000-4000-8000-00000000000a"
    },
    {
      "username": "bob",
      "email": "bob@example.com",
      "firstName": "Bob",
      "lastName": "Dupont",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "bob-pass",
          "temporary": false
        }
      ],
      "id": "00000000-0000-4000-8000-00000000000b"
    }
  ]
}
