//+------------------------------------------------------------------+
//| PnexTerminal.mq5 - PneX data source for MetaTrader 5 (D847-D849) |
//|                                                                  |
//| Generated by PneX for the terminal "{{TERMINAL}}": it carries    |
//| its own token, shown in no other place. Generating the file      |
//| again in PneX revokes this one.                                  |
//|                                                                  |
//| Read only: this Expert Advisor never sends, changes or closes    |
//| an order. It announces the broker's symbols, reads which ones    |
//| PneX wants, and pushes their closed 1-minute bars (and the ticks |
//| of the symbols chosen for ticks).                                |
//|                                                                  |
//| Setup: Tools > Options > Expert Advisors > "Allow WebRequest for |
//| listed URL" and add {{BASE}}; attach the EA to any one chart.    |
//+------------------------------------------------------------------+
#property copyright "PneX"
#property version   "{{EA_VERSION}}"
#property strict

#define PNEX_BASE    "{{BASE}}"
#define PNEX_TOKEN   "{{TOKEN}}"
// A call stays under the 1 MiB PneX accepts; what is left goes next time.
#define CALL_BYTES   700000
#define MAX_BARS     3000
#define MAX_TICKS    3000
#define ANNOUNCE_SECONDS 86400
#define HEARTBEAT_SECONDS 60

string   g_bars[];      // symbols whose bars are sent
datetime g_lastBar[];   // open time (server) of the last bar sent
string   g_ticks[];     // symbols whose ticks are sent
long     g_lastTick[];  // time_msc (server) of the last tick sent
int      g_poll = 300;
datetime g_nextConfig = 0;
datetime g_nextAnnounce = 0;
datetime g_lastSent = 0;
long     g_backfillId = 0;

//--- JSON text of a string value
string JsonText(const string s)
  {
   string out = s;
   StringReplace(out, "\\", "\\\\");
   StringReplace(out, "\"", "\\\"");
   return "\"" + out + "\"";
  }

//--- UTF-8 bytes of a string, without the trailing zero
void Utf8(const string s, uchar &out[])
  {
   int n = StringToCharArray(s, out, 0, WHOLE_ARRAY, CP_UTF8);
   ArrayResize(out, MathMax(n - 1, 0));
  }

//--- One call to PneX with the terminal's token; the HTTP status
int Call(const string method, const string path, const string body, string &answer)
  {
   uchar data[], reply[];
   if(StringLen(body) > 0)
      Utf8(body, data);
   string headers = "Authorization: Bearer " + PNEX_TOKEN + "\r\nContent-Type: application/json\r\n";
   string replyHeaders;
   ResetLastError();
   int status = WebRequest(method, PNEX_BASE + path, headers, 15000, data, reply, replyHeaders);
   answer = CharArrayToString(reply, 0, WHOLE_ARRAY, CP_UTF8);
   if(status != 200 && status != 202 && status != 204)
      PrintFormat("PnexTerminal: %s %s refused (HTTP %d, error %d)", method, path, status, GetLastError());
   return status;
  }

//--- The quoted strings of the JSON list `key` (PneX writes it flat)
int JsonList(const string json, const string key, string &out[])
  {
   ArrayResize(out, 0);
   int at = StringFind(json, "\"" + key + "\":[");
   if(at < 0)
      return 0;
   int end = StringFind(json, "]", at);
   string inner = StringSubstr(json, at + StringLen(key) + 4, end - at - StringLen(key) - 4);
   string parts[];
   int n = StringSplit(inner, '"', parts);
   for(int i = 1; i < n; i += 2)
     {
      int k = ArraySize(out);
      ArrayResize(out, k + 1);
      out[k] = parts[i];
     }
   return ArraySize(out);
  }

//--- The integer `key` of a flat JSON object, `fallback` when absent
long JsonInt(const string json, const string key, const long fallback)
  {
   int at = StringFind(json, "\"" + key + "\":");
   if(at < 0)
      return fallback;
   return StringToInteger(StringSubstr(json, at + StringLen(key) + 3, 20));
  }

//--- Seconds to subtract from a server time to get UTC (rounded to the minute)
long ServerOffset()
  {
   long diff = (long)(TimeTradeServer() - TimeGMT());
   return (long)MathRound(diff / 60.0) * 60;
  }

//--- Every symbol of the broker, with how far back its history goes
void Announce()
  {
   long offset = ServerOffset();
   int total = SymbolsTotal(false);
   string items = "";
   for(int i = 0; i < total; i++)
     {
      string s = SymbolName(i, false);
      long first = SeriesInfoInteger(s, PERIOD_M1, SERIES_SERVER_FIRSTDATE);
      if(StringLen(items) > 0)
         items += ",";
      items += StringFormat("{\"symbol\":%s,\"description\":%s,\"path\":%s,\"base\":%s,\"profit\":%s,\"digits\":%d,\"contract_size\":%.8g,\"first_m1\":%I64d}",
                            JsonText(s), JsonText(SymbolInfoString(s, SYMBOL_DESCRIPTION)),
                            JsonText(SymbolInfoString(s, SYMBOL_PATH)),
                            JsonText(SymbolInfoString(s, SYMBOL_CURRENCY_BASE)),
                            JsonText(SymbolInfoString(s, SYMBOL_CURRENCY_PROFIT)),
                            (int)SymbolInfoInteger(s, SYMBOL_DIGITS),
                            SymbolInfoDouble(s, SYMBOL_TRADE_CONTRACT_SIZE),
                            first > 0 ? first - offset : 0);
      if(StringLen(items) > CALL_BYTES || i == total - 1)
        {
         string answer;
         Call("POST", "/api/v1/mt5/announce",
              StringFormat("{\"v\":1,\"broker\":%s,\"server\":%s,\"symbols\":[%s]}",
                           JsonText(AccountInfoString(ACCOUNT_COMPANY)),
                           JsonText(AccountInfoString(ACCOUNT_SERVER)), items), answer);
         items = "";
        }
     }
  }

//--- Which symbols PneX wants; a new backfill moves the bar cursors back
void ReadConfig()
  {
   string answer;
   if(Call("GET", "/api/v1/mt5/config", "", answer) != 200)
      return;
   string bars[], ticks[];
   JsonList(answer, "bars", bars);
   JsonList(answer, "ticks", ticks);
   g_poll = (int)MathMax(JsonInt(answer, "poll_seconds", 300), 30);
   long backfillId = JsonInt(answer, "backfill_id", 0);
   datetime backfillFrom = (datetime)JsonInt(answer, "backfill_from", 0);
   bool backfill = backfillId != 0 && backfillId != g_backfillId &&
                   !GlobalVariableCheck("pnex_backfill_" + IntegerToString(backfillId));
   long offset = ServerOffset();
   // Keep the cursors of the symbols already sent.
   string oldBars[];
   datetime oldLast[];
   ArrayCopy(oldBars, g_bars);
   ArrayCopy(oldLast, g_lastBar);
   ArrayResize(g_bars, 0);
   ArrayResize(g_lastBar, 0);
   for(int i = 0; i < ArraySize(bars); i++)
     {
      if(!SymbolSelect(bars[i], true))
         continue;
      int k = ArraySize(g_bars);
      ArrayResize(g_bars, k + 1);
      ArrayResize(g_lastBar, k + 1);
      g_bars[k] = bars[i];
      // Start from now: the history comes from a backfill asked in PneX.
      g_lastBar[k] = iTime(bars[i], PERIOD_M1, 1);
      for(int j = 0; j < ArraySize(oldBars); j++)
         if(oldBars[j] == bars[i])
            g_lastBar[k] = oldLast[j];
      if(backfill && backfillFrom > 0)
         g_lastBar[k] = (datetime)(backfillFrom + offset - 60);
     }
   if(backfill)
     {
      g_backfillId = backfillId;
      GlobalVariableSet("pnex_backfill_" + IntegerToString(backfillId), 1);
     }
   string oldTicks[];
   long oldTick[];
   ArrayCopy(oldTicks, g_ticks);
   ArrayCopy(oldTick, g_lastTick);
   ArrayResize(g_ticks, 0);
   ArrayResize(g_lastTick, 0);
   for(int i = 0; i < ArraySize(ticks); i++)
     {
      if(!SymbolSelect(ticks[i], true))
         continue;
      int k = ArraySize(g_ticks);
      ArrayResize(g_ticks, k + 1);
      ArrayResize(g_lastTick, k + 1);
      g_ticks[k] = ticks[i];
      g_lastTick[k] = (long)TimeTradeServer() * 1000;
      for(int j = 0; j < ArraySize(oldTicks); j++)
         if(oldTicks[j] == ticks[i])
            g_lastTick[k] = oldTick[j];
     }
  }

//--- Sends what is gathered; the cursors move only once PneX kept it
bool Flush(const string bars, const string ticks)
  {
   string answer;
   string body = StringFormat("{\"v\":1,\"broker\":%s,\"ea_version\":\"{{EA_VERSION}}\",\"build\":%d,\"bars\":[%s],\"ticks\":[%s]}",
                              JsonText(AccountInfoString(ACCOUNT_COMPANY)),
                              (int)TerminalInfoInteger(TERMINAL_BUILD), bars, ticks);
   bool kept = Call("POST", "/api/v1/mt5/ingest", body, answer) == 202;
   if(kept)
      g_lastSent = TimeLocal();
   return kept;
  }

void Push()
  {
   long offset = ServerOffset();
   string bars = "", ticks = "";
   // Cursors of the call being gathered, applied once it is kept.
   datetime pendingBar[];
   long pendingTick[];
   ArrayCopy(pendingBar, g_lastBar);
   ArrayCopy(pendingTick, g_lastTick);
   for(int i = 0; i < ArraySize(g_bars); i++)
     {
      string sym = g_bars[i];
      int digits = (int)SymbolInfoInteger(sym, SYMBOL_DIGITS);
      datetime forming = iTime(sym, PERIOD_M1, 0);
      MqlRates rates[];
      int nb = CopyRates(sym, PERIOD_M1, g_lastBar[i] + 60, forming - 1, rates);
      int sent = 0;
      for(int r = 0; r < nb && sent < MAX_BARS; r++)
        {
         if(rates[r].time <= g_lastBar[i] || rates[r].time >= forming)
            continue;
         sent++;
         if(StringLen(bars) > 0)
            bars += ",";
         bars += StringFormat("{\"symbol\":%s,\"time\":%I64d,\"open\":\"%s\",\"high\":\"%s\",\"low\":\"%s\",\"close\":\"%s\",\"volume\":%I64d}",
                              JsonText(sym), (long)rates[r].time - offset,
                              DoubleToString(rates[r].open, digits), DoubleToString(rates[r].high, digits),
                              DoubleToString(rates[r].low, digits), DoubleToString(rates[r].close, digits),
                              rates[r].tick_volume);
         pendingBar[i] = rates[r].time;
        }
      if(StringLen(bars) > CALL_BYTES)
        {
         if(!Flush(bars, ""))
            return;
         ArrayCopy(g_lastBar, pendingBar);
         bars = "";
        }
     }
   for(int i = 0; i < ArraySize(g_ticks); i++)
     {
      string sym = g_ticks[i];
      int digits = (int)SymbolInfoInteger(sym, SYMBOL_DIGITS);
      MqlTick tk[];
      long now = (long)TimeTradeServer() * 1000;
      int nt = CopyTicksRange(sym, tk, COPY_TICKS_INFO, (ulong)(g_lastTick[i] + 1), (ulong)now);
      int upto = MathMin(nt, MAX_TICKS);
      for(int t = 0; t < upto; t++)
        {
         if(StringLen(ticks) > 0)
            ticks += ",";
         ticks += StringFormat("{\"symbol\":%s,\"time_msc\":%I64d,\"bid\":\"%s\",\"ask\":\"%s\"}",
                               JsonText(sym), tk[t].time_msc - offset * 1000,
                               DoubleToString(tk[t].bid, digits), DoubleToString(tk[t].ask, digits));
         pendingTick[i] = tk[t].time_msc;
        }
      if(StringLen(bars) + StringLen(ticks) > CALL_BYTES)
         break;
     }
   bool idle = StringLen(bars) == 0 && StringLen(ticks) == 0;
   // Nothing new: a call without data every minute says the terminal is up.
   if(idle && TimeLocal() - g_lastSent < HEARTBEAT_SECONDS)
      return;
   if(Flush(bars, ticks))
     {
      ArrayCopy(g_lastBar, pendingBar);
      ArrayCopy(g_lastTick, pendingTick);
     }
  }

int OnInit()
  {
   EventSetTimer(10);
   return INIT_SUCCEEDED;
  }

void OnDeinit(const int reason)
  {
   EventKillTimer();
  }

void OnTimer()
  {
   // The local clock: the server's stands still while the market is closed.
   datetime now = TimeLocal();
   if(now >= g_nextAnnounce)
     {
      Announce();
      g_nextAnnounce = now + ANNOUNCE_SECONDS;
      g_nextConfig = 0;
     }
   if(now >= g_nextConfig)
     {
      ReadConfig();
      g_nextConfig = now + g_poll;
     }
   Push();
  }
//+------------------------------------------------------------------+
