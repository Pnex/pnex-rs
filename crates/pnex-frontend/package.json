{
  "name": "pnex-frontend-css",
  "version": "1.0.0",
  "scripts": {
    "css:build": "tailwindcss -i style/tailwind.css -o assets/tailwind.css",
    "css:watch": "tailwindcss -i style/tailwind.css -o assets/tailwind.css --watch",
    "js:build": "esbuild js/flasher.js --bundle --format=iife --outfile=assets/flasher.js",
    "js:viewers": "esbuild js/viewers.js --bundle --format=iife --outfile=assets/viewers.js",
    "js:map": "esbuild node_modules/maplibre-gl/dist/maplibre-gl-worker.mjs --bundle --format=iife --outfile=assets/.map-worker.js && cp assets/.map-worker.js assets/.map-worker.txt && esbuild js/map.js --bundle --format=iife --loader:.txt=text --outfile=assets/map.js",
    "js:doc": "esbuild js/doc.js --bundle --minify --format=iife --outfile=assets/doc.js",
    "js:graph": "esbuild js/graph.js --bundle --minify --format=iife --outfile=assets/graph.js"
  },
  "type": "commonjs",
  "dependencies": {
    "@sigma/edge-curve": "3.1.0",
    "@sigma/node-border": "3.0.0",
    "esptool-js": "0.6.1",
    "graphology": "0.26.0",
    "graphology-layout-forceatlas2": "0.10.1",
    "graphology-layout-noverlap": "0.4.2",
    "gsplat": "^1.2.0",
    "lib0": "0.2.119",
    "maplibre-gl": "^6.10.0",
    "markdown-it": "15.0.2",
    "pannellum": "2.5.7",
    "prosemirror-commands": "1.7.2",
    "prosemirror-inputrules": "1.5.1",
    "prosemirror-keymap": "1.2.3",
    "prosemirror-markdown": "1.13.8",
    "prosemirror-model": "1.25.12",
    "prosemirror-schema-basic": "1.2.5",
    "prosemirror-schema-list": "1.5.1",
    "prosemirror-state": "1.4.4",
    "prosemirror-view": "1.42.6",
    "sigma": "3.0.2",
    "y-prosemirror": "1.3.7",
    "y-protocols": "1.0.7",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "esbuild": "0.28.2",
    "tailwindcss": "4.3.3"
  },
  "private": true
}
