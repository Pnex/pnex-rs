# Build context for deploy/docker/Dockerfile — keep it lean: target/ alone
# weighs tens of GB.
target/
vendor/edgelinkd/target/
vendor/CoolProp/install_root/
vendor/CoolProp/Web/
**/node_modules/
**/.pio/
**/.venv/
**/__pycache__/
graphify-out/
**/graphify-out/
.git/
.task/
.claude/
.idea/
.vscode/
*.swp

# Generated front outputs (rebuilt inside the image)
crates/pnex-frontend/dist/
crates/pnex-frontend/.dx/
crates/pnex-frontend/assets/tailwind.css
crates/pnex-frontend/assets/flasher.js
crates/pnex-frontend/assets/viewers.js
crates/pnex-frontend/assets/viewers.css
crates/pnex-frontend/assets/map.js
crates/pnex-frontend/assets/map.css
crates/pnex-frontend/assets/.map-worker.*

# Runtime state and secrets
crates/pnex-backend/flow-state/
crates/pnex-backend/storage/
**/*.sqlite
.env
.env.*
deploy/edge/pki-data/
deploy/edge/edge.env
secrets/
*.age
