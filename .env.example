# Copier vers .env (gitignoré) et adapter.
# Consommé par compose.yaml (substitution ${VAR}) et le backend Loco.

# PostgreSQL (compose.yaml)
DATABASE_URL=postgres://pnex:pnex@localhost:5432/pnex

# Keycloak (http://localhost:8080, admin/admin en dev — voir compose.yaml)
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=pnex-realm
KEYCLOAK_CLIENT_ID=pnex
# Tests (base jetable/vidée entre tests — voir config/test.yaml)
TEST_DATABASE_URL=postgres://pnex:pnex@localhost:5432/pnex_test

# Pagination (D14) — limite par défaut de TOUTES les listes de l'API
# (enveloppe {count, next, previous, results} ; max 100 par page).
#PAGINATION_DEFAULT_LIMIT=10

# Ingestion Phase 5 — bail de vie, reaper, revalidation, batching
# (défauts : 10 s / 5 s / 10 s / 500 / 10 s — cf. services/settings.rs)
#PNEX_SILENCE_TTL_SECS=10
#PNEX_REAPER_INTERVAL_SECS=5
#PNEX_TOKEN_CACHE_SECS=10
#PNEX_BATCH_MAX=500
#PNEX_BATCH_FLUSH_SECS=10

# OpenObserve (compose.yaml, http://localhost:5080) — télémétrie (D1/D2).
# Le compte root sert au provisioning (org par org PNEX + user d'ingestion,
# credentials correlés en base) ; l'ingestion utilise le passcode du user.
# ⚠ Politique O2 : 8-128 chars, minuscule + majuscule + chiffre + spécial.
#OPENOBSERVE_URL=http://localhost:5080
#OPENOBSERVE_ROOT_EMAIL=root@pnex.local
#OPENOBSERVE_ROOT_PASSWORD=Pnex-dev-2026!

# Firmware Phase 6 — worker de build (STORAGE_BACKEND surcharge la config).
# ⚠ En dev, driver la queue : `cargo run --bin pnex-server -- start
#   --server-and-worker` (loco start nu = serveur seul, cf. Phase 5).
# Préchauffer le cache pio une fois (uv run pio run dans soil_sensor) sinon
# le premier build télécharge les toolchains (~/.platformio).
#STORAGE_BACKEND=local
#PNEX_ARTIFACTS_DIR=./artifacts
#PNEX_FIRMWARE_SOURCE_KIND=local
#PNEX_FIRMWARE_SOURCE_PATH=/home/shan/Documents/shan-perso/pnex-firmwares
#PNEX_FIRMWARE_GIT_REPO=https://github.com/Pnex/iot-firmware.git
#PNEX_FIRMWARE_GIT_REF=main
# Machine de dev : PNEX_PIO_CMD="uv run pio" (sinon pio sur le PATH ;
# pas de guillemets dans la valeur — script wrapper sinon)
#PNEX_PIO_CMD=pio
#PNEX_ESPTOOL_CMD=esptool
#PNEX_BUILD_TIMEOUT_SECS=900
#PNEX_QUEUE_NUM_WORKERS=1
# S3 différé (D5) — plomberie uniquement
#PNEX_S3_ENDPOINT=
#PNEX_S3_BUCKET=
#PNEX_S3_REGION=
#PNEX_S3_PATH_STYLE=false
