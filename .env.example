# Copier vers .env (gitignoré) et adapter.
# Consommé par compose.yaml (substitution ${VAR}) et le backend Loco.

# ── Tiers de déploiement (D5 v2) ─────────────────────────────────────────────
# postgres (scalable, défaut) : tout en PG — pods API stateless, n'importe
#   quel réplica sert le download firmware.
# sqlite (hobbyiste, tout-en-un) : tout dans un fichier (données + artefacts
#   + queue), mono-pod uniquement :
#   DATABASE_URL="sqlite://./pnex.sqlite?mode=rwc"  (jamais sqlite::memory:)
# s3 (industriel) : STORAGE_BACKEND=s3 + PNEX_S3_* (artefacts sur S3-compatible).
# ⚠ Aucun système de migration/réconciliation entre tiers : choisir à
#   l'installation (changement = table rase / export-import manuel).
DATABASE_URL=postgres://pnex:pnex@localhost:5432/pnex

# Rauthy (IdP OIDC full-Rust, http://localhost:8080, admin/admin en dev —
# voir compose.yaml ; admin UI : /auth/v1/admin, mails dev : mailcrab :1080)
RAUTHY_URL=http://localhost:8080
RAUTHY_CLIENT_ID=pnex
# Tests (base jetable/vidée entre tests — voir config/test.yaml)
TEST_DATABASE_URL=postgres://pnex:pnex@localhost:5432/pnex_test

# Pagination (D14) — limite par défaut de TOUTES les listes de l'API
# (enveloppe {count, next, previous, results} ; max 100 par page).
#PAGINATION_DEFAULT_LIMIT=10

# Ingestion Phase 5 — bail de vie, reaper, revalidation, batching
# (défauts : 10 s / 5 s / 10 s / 500 / 10 s — cf. services/settings.rs)
#PNEX_SILENCE_TTL_SECS=10
#PNEX_REAPER_INTERVAL_SECS=5
#PNEX_TOKEN_CACHE_SECS=10

# Moteur de flow ETL (D18) — superviseur du runtime headless pnex-flow-runtime.
# enabled=false : flows éditables en base mais jamais exécutés (défaut).
#PNEX_FLOW_ENABLED=true
#PNEX_FLOW_RUNTIME_CMD=./target/debug/pnex-flow-runtime
#PNEX_FLOW_STATE_DIR=./flow-state
#PNEX_FLOW_BACKOFF_SECS=5
#PNEX_FLOW_TERMINATE_SECS=10
#PNEX_BATCH_MAX=500
#PNEX_BATCH_FLUSH_SECS=10

# OpenObserve (compose.yaml, http://localhost:5080) — télémétrie (D1/D2).
# Le compte root sert au provisioning (org par org PNEX + user d'ingestion,
# credentials correlés en base) ; l'ingestion utilise le passcode du user.
# ⚠ Politique O2 : 8-128 chars, minuscule + majuscule + chiffre + spécial.
#OPENOBSERVE_URL=http://localhost:5080
#OPENOBSERVE_ROOT_EMAIL=root@pnex.local
#OPENOBSERVE_ROOT_PASSWORD=Pnex-dev-2026!

# Firmware Phase 6 — worker de build. Artefacts en base par défaut (D5 v2,
# table firmware_artifacts) ; STORAGE_BACKEND (db | s3) surcharge la config.
# ⚠ En dev, driver la queue : `cargo run --bin pnex-server -- start
#   --server-and-worker` (loco start nu = serveur seul, cf. Phase 5).
# Préchauffer le cache pio une fois (uv run pio run dans soil_sensor) sinon
# le premier build télécharge les toolchains (~/.platformio).
#STORAGE_BACKEND=db
# Machine de dev : PNEX_PIO_CMD="uv run pio" (sinon pio sur le PATH ;
# pas de guillemets dans la valeur — script wrapper sinon)
#PNEX_PIO_CMD=pio
#PNEX_ESPTOOL_CMD=esptool
#PNEX_BUILD_TIMEOUT_SECS=900
#PNEX_QUEUE_NUM_WORKERS=1
# S3 = tier industriel (D5 v2) — artefacts sur S3-compatible (AWS, RustFS,
# Scaleway…), données + queue restent en base. Path-style pour RustFS &
# auto-hébergé (host virtuel pour AWS). Credentials : jamais commités.
# Stack locale : `docker compose up -d` (service rustfs + création des
# buckets pnex/pnex-test) — valeurs pour tester localement le tier s3 :
#PNEX_S3_ENDPOINT=http://localhost:9000
#PNEX_S3_BUCKET=pnex
#PNEX_S3_REGION=
#PNEX_S3_ACCESS_KEY=rustfsadmin
#PNEX_S3_SECRET_KEY=rustfsadmin
#PNEX_S3_PATH_STYLE=true
# (compose.yaml expose aussi RUSTFS_ACCESS_KEY/RUSTFS_SECRET_KEY si tu
# veux changer les credentials du service local)
